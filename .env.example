# GridCraft Environment Variables
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# GitHub App: gridcraft-auth
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
